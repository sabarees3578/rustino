{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rustino",
  "version": "0.3.1",
  "identifier": "com.rustino.ide",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rustino — Arduino Workbench",
        "decorations": false,
        "width": 1460,
        "height": 940,
        "minWidth": 980,
        "minHeight": 640,
        "backgroundColor": "#111318"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png", "icons/rustino.ico"]
  }
}
